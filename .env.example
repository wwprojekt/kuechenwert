###############################################################################
# KuechenWert v2 - Environment Variables
###############################################################################
# Copy this file to .env.local for local dev (gitignored).
# For production (Dokploy/Netlify/Vercel), set these in the deployment dashboard.
###############################################################################

# ----------------------------------------------------------------------------
# Supabase (PUBLIC - embedded in client bundle, safe to expose)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://gzqayoalwtmypndrmqes.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_y310eCMmlhSjvXbOKDgY1Q_p2v56GAz
VITE_SUPABASE_PROJECT_ID=gzqayoalwtmypndrmqes

# ----------------------------------------------------------------------------
# Analytics / Tracking (optional - leave empty in dev)
# ----------------------------------------------------------------------------
# Google Ads / GA4: keine Env-Variablen. Conversion-ID und Labels stehen in
# site_settings.tracking_config (Admin → Einstellungen → Tracking).

# Meta (Facebook) Pixel
VITE_META_PIXEL_ID=

# Bing UET (Microsoft Advertising)
VITE_BING_UET_TAG=

# ----------------------------------------------------------------------------
# Bot-Schutz (optional)
# ----------------------------------------------------------------------------
# Cloudflare Turnstile: Site-Key eines Widgets mit Hostname kuechenwert24.de.
# Leer = Turnstile bleibt aus (Honeypot + Rate-Limit schützen weiter).
# Gegenstück serverseitig: CLOUDFLARE_TURNSTILE_SECRET (siehe unten).
VITE_TURNSTILE_SITE_KEY=

# ----------------------------------------------------------------------------
# Build settings
# ----------------------------------------------------------------------------
# Ensures Vite emits source maps for Sentry in production
# VITE_BUILD_SOURCEMAP=true

###############################################################################
# SERVER-ONLY Secrets (Supabase Edge Functions) - NEVER put in VITE_*
###############################################################################
# These are configured via: supabase secrets set --project-ref gzqayoalwtmypndrmqes
#
# RESEND_API_KEY=re_xxxxxxxxxxxx          # for transactional emails
# RESEND_FROM_EMAIL=noreply@kuechenwert24.de
# SERVICE_ROLE_KEY=...                    # auto-set by Supabase
# SUPABASE_URL=...                        # auto-set by Supabase
#
# Optional (for future features):
# FAL_KEY=...                             # for Funnel C (Traumkueche AI)
# OPENAI_API_KEY=...                      # for Funnel C (Refine chat)
# CLOUDFLARE_TURNSTILE_SECRET=...         # Secret zum Widget von VITE_TURNSTILE_SITE_KEY
# STRIPE_SECRET_KEY=...                   # for payments (if needed)
#
# Google Ads API (kw-google-ads, Health-Check in kw-maintenance): Zugangsdaten
# liegen im Supabase Vault (gads_developer_token, gads_oauth_client_id,
# gads_oauth_client_secret, gads_oauth_refresh_token). Gesetzte Env-Secrets
# haben Vorrang:
# GADS_DEVELOPER_TOKEN=...
# GADS_OAUTH_CLIENT_ID=...
# GADS_OAUTH_CLIENT_SECRET=...
# GADS_OAUTH_REFRESH_TOKEN=...
# GADS_CUSTOMER_ID=7603767237             # Standard in _shared/google-ads.ts
# GADS_LOGIN_CUSTOMER_ID=9746508145       # Verwaltungskonto (MCC)
