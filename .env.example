###############################################################################
# KuechenWert v2 - Environment Variables
###############################################################################
# Copy this file to .env.local for local dev (gitignored).
# For production (Dokploy/Netlify/Vercel), set these in the deployment dashboard.
###############################################################################

# ----------------------------------------------------------------------------
# Supabase (PUBLIC - embedded in client bundle, safe to expose)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://gzqayoalwtmypndrmqes.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_y310eCMmlhSjvXbOKDgY1Q_p2v56GAz
VITE_SUPABASE_PROJECT_ID=gzqayoalwtmypndrmqes

# ----------------------------------------------------------------------------
# Analytics / Tracking (optional - leave empty in dev)
# ----------------------------------------------------------------------------
# Google Ads Conversion Tracking
VITE_GOOGLE_ADS_CONVERSION_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel
VITE_META_PIXEL_ID=

# Bing UET (Microsoft Advertising)
VITE_BING_UET_TAG=

# ----------------------------------------------------------------------------
# Build settings
# ----------------------------------------------------------------------------
# Ensures Vite emits source maps for Sentry in production
# VITE_BUILD_SOURCEMAP=true

###############################################################################
# SERVER-ONLY Secrets (Supabase Edge Functions) - NEVER put in VITE_*
###############################################################################
# These are configured via: supabase secrets set --project-ref gzqayoalwtmypndrmqes
#
# RESEND_API_KEY=re_xxxxxxxxxxxx          # for transactional emails
# RESEND_FROM_EMAIL=noreply@kuechenwert.de
# SERVICE_ROLE_KEY=...                    # auto-set by Supabase
# SUPABASE_URL=...                        # auto-set by Supabase
#
# Optional (for future features):
# FAL_KEY=...                             # for Funnel C (Traumkueche AI)
# OPENAI_API_KEY=...                      # for Funnel C (Refine chat)
# TURNSTILE_SECRET_KEY=...                # for Cloudflare Turnstile
# STRIPE_SECRET_KEY=...                   # for payments (if needed)
# GOOGLE_ADS_DEVELOPER_TOKEN=...          # for offline conversion tracking
